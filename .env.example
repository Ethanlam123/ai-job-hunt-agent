# Supabase Configuration
# Get these from your Supabase project dashboard (supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://postgres:[password]@db.your-project-id.supabase.co:5432/postgres

# Service Role Key (Development Only!)
# ⚠️  WARNING: Never use this in production client-facing code!
# This key bypasses Row Level Security (RLS) and should only be used for:
# - Development and testing
# - Database admin operations
# - Background scripts and migrations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Services API Keys

# OpenRouter (LLM & Embeddings Service)
# Get your API key from https://openrouter.ai/keys
# Used for:
#   - GPT-5-nano (LLM)
#   - qwen/qwen3-embedding-8b (embeddings)
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: Tavily API Key
# Get your API key from https://tavily.com
# Used for web search capabilities (if implemented)
# TAVILY_API_KEY=your-tavily-api-key

# Optional: LangSmith Tracing
# Enable tracing for LangChain agents and workflows
# Get these from https://smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=job-hunt-agent
# LANGCHAIN_API_KEY=your-langsmith-api-key

# Application Configuration
# The public URL of your deployed application
# Used as referer for OpenRouter API calls
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Development Override
# Uncomment for local development
# NEXT_PUBLIC_SITE_URL=http://localhost:3000