# Supabase Configuration
# Get these from your Supabase project dashboard (supabase.com)

# Public/Publishable Key (Client-side)
# Safe to expose in browser - used for anonymous access
# Format: Legacy (anon key) or New (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database Connection String (Optional)
# Used for Drizzle ORM migrations and direct database access
DATABASE_URL=postgresql://postgres:[password]@db.your-project-id.supabase.co:5432/postgres

# Secret Key (Testing Only! - Recommended)
# NEW FORMAT: sb_secret_... (Recommended - has browser protection)
# Required for running test suite (cleanup, admin operations)
# NEVER use in production - bypasses Row Level Security (RLS)
# Get from: https://supabase.com/dashboard/project/[project-id]/settings/api
# Create new API keys and copy the "Secret" key (not "Service role key")
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Legacy Service Role Key (Deprecated - Still Works)
# JWT-based key format - will be deprecated in the future
# Use SUPABASE_SECRET_KEY instead if possible
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Services API Keys

# OpenRouter (LLM & Embeddings Service)
# Get your API key from https://openrouter.ai/keys
# Used for:
#   - GPT-5-nano (LLM)
#   - qwen/qwen3-embedding-8b (embeddings)
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: Tavily API Key
# Get your API key from https://tavily.com
# Used for web search capabilities (if implemented)
# TAVILY_API_KEY=your-tavily-api-key

# Optional: LangSmith Tracing
# Enable tracing for LangChain agents and workflows
# Get these from https://smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=job-hunt-agent
# LANGCHAIN_API_KEY=your-langsmith-api-key

# Application Configuration
# The public URL of your deployed application
# Used as referer for OpenRouter API calls
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Development Override
# Uncomment for local development
# NEXT_PUBLIC_SITE_URL=http://localhost:3000