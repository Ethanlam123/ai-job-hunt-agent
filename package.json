{
  "name": "ai-job-hunt-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered job hunting agent with CV analysis, interview preparation, and skill gap analysis",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:strict": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "jest --testPathPattern=integration",
    "test:security": "jest --testPathPattern=security",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:cleanup": "npx tsx scripts/cleanup-database.ts",
    "db:apply-rls": "npx tsx scripts/apply-rls-policies.ts",
    "db:reset": "npm run db:cleanup && npm run db:push && npm run db:apply-rls",
    "db:fix-all-rls": "npx tsx scripts/fix-all-rls-policies.ts",
    "setup": "./setup.sh",
    "clean": "rm -rf .next out node_modules/.cache",
    "analyze": "ANALYZE=true npm run build",
    "docs:generate": "npm run docs:api && npm run docs:components && npm run docs:database",
    "docs:api": "npx tsx scripts/generate-api-docs.ts",
    "docs:components": "npx tsx scripts/generate-component-docs.ts",
    "docs:database": "npx tsx scripts/generate-db-docs.ts",
    "docs:coverage": "npx tsx scripts/check-docs-coverage.ts",
    "docs:build": "npm run docs:generate && npm run docs:coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@langchain/community": "^1.0.0",
    "@langchain/core": "^1.0.1",
    "@langchain/openai": "^1.0.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.76.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.7",
    "langchain": "^1.0.1",
    "lucide-react": "^0.553.0",
    "mammoth": "^1.11.0",
    "next": "^16.0.1",
    "next-themes": "^0.4.6",
    "openai": "^6.8.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "pgvector": "^0.2.1",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "zod": "^3.23.8",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.0.1",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "supabase": "^2.53.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ai-job-hunt-agent.git"
  },
  "keywords": [
    "ai",
    "job-hunt",
    "cv-analysis",
    "interview-preparation",
    "skill-gap",
    "nextjs",
    "typescript",
    "supabase",
    "langchain"
  ],
  "author": "Your Name",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/your-username/ai-job-hunt-agent/issues"
  },
  "homepage": "https://github.com/your-username/ai-job-hunt-agent#readme"
